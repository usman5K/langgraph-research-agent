# Required for live runs (tests never need it)
OPENAI_API_KEY=sk-...
# Chat model used as the agent's "brain"
MODEL=gpt-4o-mini
# Optional: use Tavily for web search; falls back to DuckDuckGo when unset
TAVILY_API_KEY=
# Hard cap on agent (LLM) turns per question
MAX_STEPS=6
# Folder of markdown files indexed by the search_docs tool
DOCS_DIR=docs
# auto | openai | hashing  (auto = OpenAI embeddings if a key is set, else offline hashing)
EMBEDDINGS=auto
